# apps/api/.env.example
#
# ─── Deployment URL Configuration ──────────────────────────────────────────────
#
# FRONTEND_URL  — The public, browser-facing root URL of the MakerLab web app.
#                 Include a path prefix if the app is deployed under a sub-path.
#                 Examples:
#                   With /new prefix:  https://deti-makerlab.ua.pt/new
#                   Without prefix:    https://deti-makerlab.ua.pt
#                   On another domain: https://makerlab.example.com
#
# SNIPEIT_PUBLIC_URL — The public, browser-facing URL of the Snipe-IT interface.
#                      Used by:
#                        - The sidebar link that opens Snipe-IT in the browser
#                        - The nginx 401 redirect for unauthenticated Snipe-IT access
#                        - The Snipe-IT logout → MakerLab redirect
#                      Examples:
#                        With /new prefix:  https://deti-makerlab.ua.pt/new/snipe-it
#                        Without prefix:    https://deti-makerlab.ua.pt/snipe-it
#
# SSO_CALLBACK_URL — The fixed callback URL registered with the University SSO provider.
#                    This must match exactly what was registered at identity.ua.pt.
#                    It does NOT include a path prefix (it maps to a top-level nginx
#                    location block that is prefix-agnostic).
#                    Example: https://deti-makerlab.ua.pt/auth/auth
#
# SNIPEIT_BASE_URL — Internal Docker network URL for backend→Snipe-IT API calls.
#                    Never exposed to the browser. Always use the Docker service name.
#                    Example: http://snipeit
#
# ─── How to deploy under a path prefix (e.g. /new) ─────────────────────────────
#   FRONTEND_URL=https://deti-makerlab.ua.pt/new
#   SNIPEIT_PUBLIC_URL=https://deti-makerlab.ua.pt/new/snipe-it
#   SSO_CALLBACK_URL=https://deti-makerlab.ua.pt/auth/auth   ← no /new here
#
# ─── How to deploy at root (no prefix) ──────────────────────────────────────────
#   FRONTEND_URL=https://deti-makerlab.ua.pt
#   SNIPEIT_PUBLIC_URL=https://deti-makerlab.ua.pt/snipe-it
#   SSO_CALLBACK_URL=https://deti-makerlab.ua.pt/auth/auth
#
# After changing any URL variable, rebuild/restart the relevant containers:
#   docker compose -f infra/docker/docker-compose.yml up -d --build
# ────────────────────────────────────────────────────────────────────────────────

APP_ENV=production
APP_DEBUG=false

DATABASE_URL=postgresql+psycopg://makerlab_app:password@postgres:5432/makerlab
POSTGRES_USER=makerlab
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=makerlab

# Internal Docker network URL — backend-to-Snipe-IT API calls only
SNIPEIT_BASE_URL=http://snipeit
SNIPEIT_API_TOKEN=YOUR_SNIPEIT_API_TOKEN
SNIPEIT_RESERVED_STATUS_ID=4

# Public browser-facing URL of the MakerLab frontend (no trailing slash)
FRONTEND_URL=https://deti-makerlab.ua.pt/new

# Public browser-facing URL of the Snipe-IT interface (no trailing slash)
SNIPEIT_PUBLIC_URL=https://deti-makerlab.ua.pt/new/snipe-it

# SSO callback URL — must match registration at identity.ua.pt (no path prefix)
SSO_CALLBACK_URL=https://deti-makerlab.ua.pt/auth/auth

# OAuth1 / Universidade de Aveiro
DML_AUTH_KEY=your_client_key_here
DML_AUTH_SECRET=your_client_secret_here

# JWT
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of university emails to grant the lab_technician role
LAB_TECHNICIANS=lab.tech@ua.pt,another.labtech@ua.pt